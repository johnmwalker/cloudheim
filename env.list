PORT=2456
NAME=valdockforcoolboy
WORLD=rip_hermeto
TZ=America/Chicago
PUBLIC=0
# Modded server (Valheim 1.0 compatible builds, verified 2026-09-12):
# - Grantapher-ValheimPlus_*  -> 0.10.1.1 (requires BepInExPack 5.4.2350, which Odin provides)
# - JereKuusela-Server_devcommands-* -> v1.113.0; unlocks devcommands (fly, god, spawn...)
#   for players in adminlist.txt. Client-side install also required on each admin's PC.
# Pinned (not wildcards) for reproducibility; wildcards available if auto-updating mods is wanted.
TYPE=BepInEx
# Mods resolved via Thunderstore dependency strings (verified 1.0-compatible 2026-09-12).
# MUST stay on ONE line, comma-separated: env_file cannot carry multiline values
# (only the first line would reach the container - verified live 2026-09-13).
# Odin treats commas/newlines/whitespace as separators (install_mod.rs).
MODS=Grantapher-ValheimPlus_Grantapher_Temporary-10.2.0,JereKuusela-Server_devcommands-1.114.0,ValheimModding-Jotunn-2.30.2,Goldenrevolver-Quick_Stack_Store_Sort_Trash_Restock-1.4.15,MSchmoecker-MultiUserChest-0.6.2,VentureValheim-Venture_Farm_Grid-1.0.0,GemHunter1-CustomChestName-1.1.2,ishid4-BetterArchery-2.0.2,RandyKnapp-EquipmentAndQuickSlots-3.1.3,cjayride-RecycleItemsIntoParts-1.7.4
AUTO_UPDATE=1
AUTO_UPDATE_SCHEDULE="0 1 * * *"
AUTO_UPDATE_PAUSE_WITH_PLAYERS=1
AUTO_BACKUP=1
AUTO_BACKUP_SCHEDULE="*/10 * * * *"
AUTO_BACKUP_REMOVE_OLD=1
AUTO_BACKUP_DAYS_TO_LIVE=3
AUTO_BACKUP_ON_UPDATE=1
AUTO_BACKUP_ON_SHUTDOWN=1
UPDATE_ON_STARTUP=1
MODIFIERS="combat=easy,deathpenalty=casual,resources=most,raids=muchless,portals=casual"
# Post server status (incl. public IP) to the Discord webhook injected at boot.
WEBHOOK_INCLUDE_PUBLIC_IP=1
# WEBHOOK_BROADCAST_MESSAGE="Server is up?"
# WEBHOOK_INCLUDE_PUBLIC_IP=1
# These get appended via automation
# WEBHOOK_URL=
# PASSWORD=

